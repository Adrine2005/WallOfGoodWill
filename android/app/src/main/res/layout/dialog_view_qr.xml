<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvQrDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campus Verification QR"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvQrDialogLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        tools:text="Hostel Block A Main Notice Board" />

    <!-- QR Code Bitmap Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivQrBitmap"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:padding="12dp"
            android:contentDescription="Scannable QR Code"
            android:scaleType="fitCenter" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Code Display -->
    <TextView
        android:id="@+id/tvQrCodeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="@color/primary"
        tools:text="GW-NOTICEBOARD-A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:text="Students scan this QR or enter code in app to verify resident status." />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseQrDialog"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyCodeDialog"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="📋 Copy Code" />

    </LinearLayout>

</LinearLayout>

