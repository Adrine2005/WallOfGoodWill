<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Outgoing Message (Right aligned) -->
    <LinearLayout
        android:id="@+id/layoutOutgoing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:gravity="end"
        android:maxWidth="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_outgoing"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOutgoingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/surface"
                android:textSize="14sp"
                tools:text="Hey, is this still available?" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvOutgoingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="10:30 AM" />

    </LinearLayout>

    <!-- Incoming Message (Left aligned) -->
    <LinearLayout
        android:id="@+id/layoutIncoming"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:gravity="start"
        android:maxWidth="280dp">

        <TextView
            android:id="@+id/tvIncomingSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="2dp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="11sp"
            tools:text="John Doe" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_incoming"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIncomingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="Yes! Can we meet at block C?" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIncomingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="10:32 AM" />

    </LinearLayout>

</LinearLayout>
