<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WallOfGoodWill">

        <!-- Splash Screen (App Entry Point) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication & Verification Activities -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.VerifyQrActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Home & Feed -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Listings Screens -->
        <activity
            android:name=".ui.listings.CreateListingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.listings.ListingDetailActivity"
            android:exported="false" />

        <!-- Profile & My Listings Screen -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <!-- Donation Requests Screen -->
        <activity
            android:name=".ui.requests.DonationRequestsActivity"
            android:exported="false" />

        <!-- Notifications Screen -->
        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false" />

        <!-- Chat & Messaging Screens -->
        <activity
            android:name=".ui.chat.ConversationsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
